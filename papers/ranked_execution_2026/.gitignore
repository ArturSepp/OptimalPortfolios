# Public article and portable replication only. Inputs are distributed separately.
/*
!/.gitignore
!/README.md
!/paper/
/paper/*
!/paper/main.tex
!/paper/results.tex
!/paper/main.pdf
!/paper/robustness.tex
!/paper/breadth.tex
!/paper/figures/
/paper/figures/*
!/paper/figures/sensitivity.pdf
!/paper/joint_results.tex
!/paper/figures/joint_comparison.pdf
!/replication/
/replication/*
!/replication/benchmark.py
!/replication/run_benchmark.py
!/replication/summarize.py
!/replication/protocol.json
!/replication/expected_summary.json
!/replication/robustness.py
!/replication/summarize_robustness.py
!/replication/robustness_protocol.json
!/replication/robustness_run_protocol.json
!/replication/robustness_expected_summary.json
!/replication/holdout_protocol.json
!/replication/holdout_run_protocol.json
!/replication/holdout_expected_summary.json
!/replication/breadth.py
!/replication/summarize_breadth.py
!/replication/breadth_protocol.json
!/replication/breadth_run_protocol.json
!/replication/breadth_expected_summary.json
!/replication/breadth_holdout_protocol.json
!/replication/breadth_holdout_run_protocol.json
!/replication/breadth_holdout_expected_summary.json
!/replication/summarize_combinations.py
!/replication/joint.py
!/replication/summarize_joint.py
!/replication/joint_protocol.json
!/replication/joint_run_protocol.json
!/replication/joint_expected_summary.json
!/replication/tests/
/replication/tests/*
!/replication/tests/benchmark_test.py
!/replication/tests/robustness_test.py
!/replication/tests/breadth_test.py
!/replication/tests/joint_test.py
