# MANIFEST.in
# Controls what files are included in the source distribution (sdist)

# Include essential package files
include README.md
include LICENSE.txt
include pyproject.toml
include requirements*.txt

# Include all Python source files
recursive-include src/optimalportfolios *.py

# Include specific data files that the package needs
recursive-include src/optimalportfolios/data *.csv
recursive-include src/optimalportfolios/tests/data *.csv
recursive-include src/optimalportfolios/templates *.html
recursive-include src/optimalportfolios/static *.css *.js
recursive-include src/optimalportfolios *.yml *.yaml *.json *.txt *.md

# Examples are repository-only: exclude their whole root-level tree from built distributions.
recursive-exclude examples *

# Explicitly exclude notebooks, resources, and image files
recursive-exclude src/optimalportfolios/notebooks *
recursive-exclude src/optimalportfolios *figures*
global-exclude *.png
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.gif
global-exclude *.svg
global-exclude *.pdf
global-exclude *.eps
global-exclude *.ipynb

# Exclude development and build artifacts
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
recursive-exclude * .DS_Store
recursive-exclude * .git*
recursive-exclude * *.egg-info
global-exclude *.pyc
global-exclude *.pyo
